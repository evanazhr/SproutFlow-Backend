# ============================================================
# MODE ONLINE — Supabase + HiveMQ Cloud
# Cara pakai: cp .env.online.example .env, lalu isi semua <...>
# ============================================================
NODE_ENV=production
PORT=4000

# Supabase: Project Settings > Database > Connection string > Transaction pooler.
# WAJIB diakhiri ?sslmode=require (kode backend auto-aktifkan TLS untuk host non-local).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
BETTER_AUTH_URL=https://api.evanazhar.my.id
FRONTEND_URL=https://iot.evanazhar.my.id

# Google OAuth — redirect URI: https://api.evanazhar.my.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HiveMQ Cloud: MQTT over TLS (port 8883). Akun `backend` boleh publish & subscribe.
MQTT_URL=mqtts://<cluster-id>.hivemq.cloud:8883
MQTT_USERNAME=<backend-user>
MQTT_PASSWORD=<backend-password>
MQTT_TOPIC_PREFIX=plant

READING_SAMPLE_INTERVAL_SECONDS=60
PUMP_ACK_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=30
LOG_LEVEL=info
