# Mode: pakai .env.local.example (local) atau .env.online.example (Supabase + HiveMQ).
# File ini hanya referensi; jalankan `pnpm env:local` / `pnpm env:online` untuk membuat .env.
NODE_ENV=development
PORT=4000

# Database (NeonDB, sslmode=require)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Google OAuth (redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MQTT (akun backend: boleh publish & subscribe)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=plant

# Perilaku
READING_SAMPLE_INTERVAL_SECONDS=60
PUMP_ACK_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=30
LOG_LEVEL=info
