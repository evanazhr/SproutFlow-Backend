# ============================================================
# MODE LOCAL — Postgres lokal/Neon + broker MQTT lokal (mosquitto)
# Cara pakai: cp .env.local.example .env
# ============================================================
NODE_ENV=development
PORT=4000

# Postgres lokal. Kalau pakai Neon, tambahkan ?sslmode=require di ujung URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sproutflow

BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Google OAuth — redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Broker MQTT lokal dari docker-compose.yml (akun `backend`, lihat mosquitto/acl)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=sproutflow
MQTT_TOPIC_PREFIX=plant

READING_SAMPLE_INTERVAL_SECONDS=60
PUMP_ACK_TIMEOUT_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=30
LOG_LEVEL=info
