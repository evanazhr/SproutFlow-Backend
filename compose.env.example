# Opsi: salin ke compose.env lalu pakai `--env-file compose.env` saat menjalankan compose.
# Semua nilai di docker-compose.yml sudah punya default yang sama dengan di bawah
# (dan cocok dengan .env.local.example), jadi file ini tidak wajib.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sproutflow
POSTGRES_PORT=5432

# --- Mosquitto ---
MQTT_PORT=1883       # TCP: backend + ESP32
MQTT_WS_PORT=9001    # WebSocket: frontend

# Credential MQTT diatur di mosquitto/passwd (default: sproutflow untuk
# backend, device, viewer). Ganti hash-nya dengan:
#   mosquitto_passwd -b mosquitto/passwd <user> <password_baru>
